# Anthropic API key — used by the reasoning engine (Claude Haiku)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API key — used by the chat endpoint (GPT-4o-mini)
OPENAI_API_KEY=your_openai_key_here

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your Vercel deployment URL.
# Example: FRONTEND_URL=https://hvac-margin-agent.vercel.app
FRONTEND_URL=http://localhost:3000
