# Google Gemini API key — powers the AI chat assistant (gemini-3.6-flash)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Gmail OAuth2 credentials — both values are JSON strings.
#
# HOW TO GENERATE THESE (one-time setup):
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID for a "Desktop app"
#   3. Download the credentials JSON file
#   4. Run: python scripts/run_gmail_auth.py  (from the repo root)
#      This opens a browser for OAuth consent and writes token.json
#   5. Copy the contents of credentials.json here as a single-line JSON string
#   6. Copy the contents of token.json here as a single-line JSON string
#   7. Set both in Vercel: Settings → Environment Variables
#
GMAIL_CREDENTIALS={"installed":{"client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_SECRET","redirect_uris":["http://localhost"]}}
GMAIL_OAUTH_TOKEN={"token":"ACCESS_TOKEN","refresh_token":"REFRESH_TOKEN","token_uri":"https://oauth2.googleapis.com/token","client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_SECRET"}

# Optional: the Gmail address that sends emails (defaults to "me" = the authenticated account)
GMAIL_FROM_EMAIL=you@gmail.com
